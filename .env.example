# =========================================================
# APPLICATION
# =========================================================

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

API_PORT=8080
WORKER_HEALTH_PORT=8081

API_URL=http://localhost:8080

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning


# =========================================================
# SQL SERVER
# =========================================================

SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=220075
SQL_SERVER_PASSWORD=change-this-to-a-strong-sql-password

DB_CONNECTION=Server=localhost;Database=220075;Trusted_Connection=True;TrustServerCertificate=True;


# =========================================================
# JWT
# =========================================================

JWT_SECRET=change-this-to-a-random-secret-with-at-least-32-characters
JWT_ISSUER=MindBloom.API
JWT_AUDIENCE=MindBloom.Client
JWT_EXPIRATION_MINUTES=15


# =========================================================
# RABBITMQ
# =========================================================

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

RABBITMQ_CLIENT_NAME=mindbloom-api-notification-publisher
RABBITMQ_WORKER_CLIENT_NAME=mindbloom-notifications-worker

RABBITMQ_NOTIFICATION_EXCHANGE=mindbloom.notifications

RABBITMQ_EMAIL_QUEUE=mindbloom.notifications.email
RABBITMQ_EMAIL_ROUTING_KEY=notification.email

RABBITMQ_INTEGRATION_EVENT_QUEUE=mindbloom.integration-events

RABBITMQ_RETRY_EXCHANGE=mindbloom.notifications.retry

RABBITMQ_DEAD_LETTER_EXCHANGE=mindbloom.notifications.dead-letter
RABBITMQ_EMAIL_DEAD_LETTER_QUEUE=mindbloom.notifications.email.dlq
RABBITMQ_EMAIL_DEAD_LETTER_ROUTING_KEY=notification.email.dead

RABBITMQ_INTEGRATION_EVENT_DEAD_LETTER_QUEUE=mindbloom.integration-events.dlq
RABBITMQ_INTEGRATION_EVENT_DEAD_LETTER_ROUTING_KEY=integration-event.dead

RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_MAXIMUM_RETRY_COUNT=4

RABBITMQ_AUTOMATIC_RECOVERY=true
RABBITMQ_RECOVERY_INTERVAL_SECONDS=5
RABBITMQ_HEARTBEAT_SECONDS=30

RABBITMQ_CONNECTION_RETRY_COUNT=5
RABBITMQ_CONNECTION_RETRY_DELAY_SECONDS=3

RABBITMQ_DLQ_MONITORING_INTERVAL_SECONDS=60
RABBITMQ_DLQ_WARNING_MESSAGE_COUNT=1
RABBITMQ_MONITORING_INTERVAL_SECONDS=60


# =========================================================
# SMTP / EMAIL
# =========================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true

EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-app-password


# =========================================================
# STRIPE
# =========================================================

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret


# =========================================================
# FIREBASE
# =========================================================

FIREBASE_CREDENTIALS_PATH=your-path-to-firebase-service-account.json
FIREBASE_BATCH_SIZE=500
FIREBASE_RETRY_COUNT=3
FIREBASE_RETRY_DELAY_SECONDS=2

# =========================================================
# CORS
# =========================================================

Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:4200
Cors__AllowedOrigins__2=http://localhost:5173


# =========================================================
# GOOGLE MAPS
# =========================================================

GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/


# =========================================================
# UPLOADS
# =========================================================

UPLOAD_MAX_IMAGE_SIZE_MB=5
UPLOAD_MAX_DOCUMENT_SIZE_MB=10
UPLOAD_ROOT_PATH=uploads

# =========================================================
# DOCKER IMAGE VERSIONING
# =========================================================

IMAGE_VERSION=1.0.0