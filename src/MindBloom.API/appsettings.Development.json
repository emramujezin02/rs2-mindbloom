{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  },

  "DatabaseRetry": {
    "MaxRetryCount": 2,
    "MaxRetryDelaySeconds": 3
  },

  "Seed": {
    "Enabled": true
  },

  "ExternalServices": {
    "StripeMode": "Sandbox",
    "EmailMode": "Mock",
    "FirebaseMode": "Mock",
    "GeocodingMode": "Real",
    "PaymentsEnabled": false,
    "EmailEnabled": false,
    "FirebaseEnabled": false
  }
}
