{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  },

  "DatabaseRetry": {
    "MaxRetryCount": 2,
    "MaxRetryDelaySeconds": 3
  },

  "Seed": {
    "Enabled": true
  },

  "ExternalServices": {
    "StripeMode": "Sandbox",
    "EmailMode": "Real",
    "FirebaseMode": "Real",
    "GeocodingMode": "Real",
    "PaymentsEnabled": true,
    "EmailEnabled": true,
    "FirebaseEnabled": true
  }
}