{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type",
      "Accept",
      "X-Requested-With"
    ]
  },

  "RequestTiming": {
    "SlowRequestThresholdMilliseconds": 1000
  },

  "AccountLockout": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },

  "GoogleMaps": {
    "ApiKey": "",
    "GeocodingBaseUrl": "https://maps.googleapis.com/maps/api/geocode/"
  },

  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "Registration": {
      "PermitLimit": 5,
      "WindowSeconds": 600,
      "QueueLimit": 0
    },
    "ForgotPassword": {
      "PermitLimit": 3,
      "WindowSeconds": 900,
      "QueueLimit": 0
    },
    "ResetPassword": {
      "PermitLimit": 5,
      "WindowSeconds": 900,
      "QueueLimit": 0
    },
    "TwoFactorLogin": {
      "PermitLimit": 3,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "TwoFactorVerify": {
      "PermitLimit": 10,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "TwoFactorSettings": {
      "PermitLimit": 5,
      "WindowSeconds": 600,
      "QueueLimit": 0
    },
    "RefreshToken": {
      "PermitLimit": 10,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "ChatMessages": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Uploads": {
      "PermitLimit": 10,
      "WindowSeconds": 600,
      "QueueLimit": 0
    },
    "Recommendations": {
      "PermitLimit": 20,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "PublicSearch": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  }
}