{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "DatabaseRetry": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  },

  "Seed": {
    "Enabled": false
  },

  "ExternalServices": {
    "StripeMode": "Live",
    "EmailMode": "Real",
    "FirebaseMode": "Real",
    "GeocodingMode": "Real"
  }
}