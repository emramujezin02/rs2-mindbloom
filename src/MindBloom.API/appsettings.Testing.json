{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "AccountLockout": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },

  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "Registration": {
      "PermitLimit": 5,
      "WindowSeconds": 600,
      "QueueLimit": 0
    },
    "ForgotPassword": {
      "PermitLimit": 3,
      "WindowSeconds": 900,
      "QueueLimit": 0
    },
    "ResetPassword": {
      "PermitLimit": 5,
      "WindowSeconds": 900,
      "QueueLimit": 0
    },
    "TwoFactorLogin": {
      "PermitLimit": 3,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "TwoFactorVerify": {
      "PermitLimit": 10,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "TwoFactorSettings": {
      "PermitLimit": 5,
      "WindowSeconds": 600,
      "QueueLimit": 0
    },
    "RefreshToken": {
      "PermitLimit": 10,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "ChatMessages": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Uploads": {
      "PermitLimit": 10,
      "WindowSeconds": 600,
      "QueueLimit": 0
    },
    "Recommendations": {
      "PermitLimit": 20,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "PublicSearch": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  }
}